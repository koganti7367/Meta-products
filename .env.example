# These are NOT read automatically from this file — there's no build step or
# dotenv package to load it. Set the same two values directly in:
#   Netlify → Site settings → Environment variables
# (For local testing with `netlify dev`, the Netlify CLI *does* read a .env
# file in the project root automatically — copy this to .env for that case.)

# Supabase project URL (Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co

# Supabase SERVICE ROLE key (Project Settings > API) — used only inside
# Netlify Functions (server-side). NEVER put this in the public/ folder.
SUPABASE_SERVICE_KEY=your-service-role-key
